# Academic Research IDE — Environment Template
# Copy this file to `.env` if you want to override defaults via environment variables.
# Note: Runtime model settings can also be edited inside the IDE (stored in OS app data dir).

# --- LLM Provider (OpenAI-compatible: Ollama, LM Studio, or OpenAI) ---
RESEARCH_IDE_LLM_PROVIDER=ollama
RESEARCH_IDE_LLM_BASE_URL=http://127.0.0.1:11434/v1
RESEARCH_IDE_LLM_MODEL=qwen2.5:14b
RESEARCH_IDE_LLM_API_KEY=

# --- Embedding Provider ---
# Supported: openai_compatible | local_hash
RESEARCH_IDE_EMBEDDING_PROVIDER=openai_compatible
RESEARCH_IDE_EMBEDDING_BASE_URL=
RESEARCH_IDE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RESEARCH_IDE_EMBEDDING_DIM=384

# --- Local Backend Server ---
RESEARCH_IDE_API_HOST=127.0.0.1
RESEARCH_IDE_API_PORT=8765

# Optional: override OS-standard app data directory (SQLite, LanceDB, uploaded PDFs)
# RESEARCH_IDE_DATA_DIR=

# Optional: set to 1 when launching Tauri dev against an already-running uvicorn backend
# RESEARCH_IDE_EXTERNAL_BACKEND=0

# --- Frontend ---
VITE_API_BASE_URL=http://127.0.0.1:8765/api/v1
